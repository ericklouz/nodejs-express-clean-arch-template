{
  "name": "clean-arch-template",
  "version": "1.0.0",
  "description": "Base template for Node.js projects using Express and TypeScript with clean architecture. Designed to be scalable, modular, and reusable across multiple projects.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development && tsnd -r tsconfig-paths/register --respawn --clear src/index.ts",
    "build": "cross-env NODE_ENV=production && rimraf ./dist && tsc && tsc-alias -p tsconfig.json",
    "start": "run build && node dist/index.js",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\" --fix",
    "prisma:dev": "dotenv -e .env.development npx prisma db pull && npx prisma generate",
    "prisma:migrate:dev": "dotenv -e .env.development npx prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/json-bigint": "^1.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.4.0",
    "@types/nodemailer": "^6.4.15",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "husky": "^8.0.0",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.5",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "env-var": "^7.5.0",
    "express": "^4.19.2",
    "hashids": "^2.3.0",
    "json-bigint": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "prisma": {
    "schema": "src/database/postgres/prisma/schema.prisma"
  }
}
